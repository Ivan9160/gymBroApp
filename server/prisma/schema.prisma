generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int          @id @default(autoincrement())
  name        String
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  role        Role         @default(USER)
  userProfile UserProfile?
  workouts    Workout[]

  @@map("users")
}

model UserProfile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  age       Int
  gender    String
  height    Int
  weight    Float
  goal      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("user_profiles")
}

model Workout {
  id         Int       @id @default(autoincrement())
  user_id    Int
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  finishedAt DateTime? @map("finished_at")
  status     String    @default("IN_PROGRESS")
  sets       Set[]
  user_ids   User      @relation(fields: [user_id], references: [id])

  @@map("workouts")
}

model Set {
  id         Int      @id @default(autoincrement())
  workoutId  Int      @map("workout_id")
  exerciseId Int      @map("exercise_id")
  weight     Float
  reps       Int
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  workout    Workout  @relation(fields: [workoutId], references: [id])

  @@map("sets")
}

model Exercise {
  id                   Int       @id @default(autoincrement())
  exerciseGroupId      Int       @map("exercise_group_id")
  name                 String
  video                String
  benchmark            Float?
  bodyweightLoadFactor Float     @default(0.0) @map("bodyweight_load_factor")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  isBodyweight         Boolean   @default(false) @map("is_bodyweight")

  exerciseGroup ExerciseGroup @relation(fields: [exerciseGroupId], references: [id])
  muscleFactors ExerciseMuscleFactor[]
  set           Set[]

  @@map("exercises")
}


model ExerciseGroup {
  id            Int       @id @default(autoincrement())
  name          String
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  exercises     Exercise[]
  muscleFactors ExerciseMuscleFactor[]

  @@map("exercise_groups")
}


model ExerciseMuscleFactor {
  exerciseId      Int   @map("exercise_id")
  exerciseGroupId Int   @map("exercise_group_id")
  factor          Float @default(0.0)

  exercise      Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  exerciseGroup ExerciseGroup @relation(fields: [exerciseGroupId], references: [id], onDelete: Cascade)

  @@id([exerciseId, exerciseGroupId])
  @@index([exerciseGroupId])
  @@map("exercise_muscle_factors")
}

enum Role {
  USER
  ADMIN
}
